PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=./data/nexus.db
CORS_ORIGIN=http://localhost:3000
# Comma-separate multiple frontend origins for production, e.g.:
# CORS_ORIGIN=https://app.example.com,https://www.example.com
NODE_ENV=development
# Set to true on cloud hosts to disable Windows-only local device tools
# (open app/file, media keys, lock PC, screen/file search on the server).
# Auto-enabled automatically on non-Windows platforms.
CLOUD_MODE=false

# Primary AI provider: Google Gemini (owner-selected).
# One key powers STT (audio understanding), LLM, and TTS adapters.
STT_PROVIDER=gemini
LLM_PROVIDER=gemini
TTS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Fenrir
# Comma-separated fallback models tried automatically when the primary model returns 429/503/timeout
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite
GEMINI_TTS_MODEL_FALLBACKS=

# Optional alternative providers (only used when *_PROVIDER is set to them).
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
